{
  "$schema": "https://packageurl.org/schemas/purl-test.schema-0.1.json",
  "tests": [
    {
      "description": "valid opam purl. Roundtrip an input purl to canonical.",
      "test_group": "advanced",
      "test_type": "roundtrip",
      "input": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_output": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_failure": false,
      "expected_failure_reason": null
    },
    {
      "description": "valid opam purl",
      "test_group": "base",
      "test_type": "parse",
      "input": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_output": {
        "type": "opam",
        "namespace": "opam.ocaml.org",
        "name": "ocaml-base-compiler",
        "version": "5.2.0",
        "qualifiers": {
          "repo_url": "https://opam.ocaml.org"
        },
        "subpath": null
      },
      "expected_failure": false,
      "expected_failure_reason": null
    },
    {
      "description": "valid opam purl. Roundtrip a canonical input to canonical output.",
      "test_group": "base",
      "test_type": "roundtrip",
      "input": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_output": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_failure": false,
      "expected_failure_reason": null
    },
    {
      "description": "valid opam purl",
      "test_group": "base",
      "test_type": "build",
      "input": {
        "type": "opam",
        "namespace": "opam.ocaml.org",
        "name": "ocaml-base-compiler",
        "version": "5.2.0",
        "qualifiers": {
          "repo_url": "https://opam.ocaml.org"
        },
        "subpath": null
      },
      "expected_output": "pkg:opam/opam.ocaml.org/ocaml-base-compiler@5.2.0?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_failure": false,
      "expected_failure_reason": null
    },
    {
      "description": "name is required",
      "test_group": "base",
      "test_type": "parse",
      "input": "pkg:opam?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_output": null,
      "expected_failure": true,
      "expected_failure_reason": "Should fail to parse a PURL from invalid purl input"
    },
    {
      "description": "name is required in canonical form",
      "test_group": "base",
      "test_type": "parse",
      "input": "pkg:opam?repo_url=https%3A%2F%2Fopam.ocaml.org",
      "expected_output": null,
      "expected_failure": true,
      "expected_failure_reason": "Should fail to parse a PURL from invalid canonical purl input"
    },
    {
      "description": "name is required to build",
      "test_group": "base",
      "test_type": "build",
      "input": {
        "type": "opam",
        "namespace": "opam.ocaml.org",
        "name": null,
        "version": "5.2.0",
        "qualifiers": {
          "repo_url": "https://opam.ocaml.org"
        },
        "subpath": null
      },
      "expected_output": null,
      "expected_failure": true,
      "expected_failure_reason": "Should fail to build a PURL from invalid input components"
    },
